        PermissionDenied: Si pas COMMERCIAL
    
    Business Rules:
        - Transition FSM Opportunity: INSOMEA_QUOTE_CREATED → CLIENT_PO_REQUEST
        - 🆕 Envoi email client avec PDF InsomeaQuote
    """
    
    # ... (garder toute la logique existante)
    
    # ───────────────────────────────────────────────────────
    # 3. TRANSITION FSM
    # ───────────────────────────────────────────────────────
    
    opportunity.request_client_po()
    opportunity.save()
    # Signal FSM → StatusHistory créé auto
    
    # ───────────────────────────────────────────────────────
